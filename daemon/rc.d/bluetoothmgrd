#!/bin/sh
#
# PROVIDE: bluetoothmgrd
# REQUIRE: DAEMON hcsecd
# KEYWORD: nojail shutdown
#
# bluetoothmgrd_enable="YES"
# bluetoothmgrd_socket="/var/run/bluetoothmgr.sock"
# bluetoothmgrd_pidfile="/var/run/bluetoothmgrd.pid"
# bluetoothmgrd_flags=""

. /etc/rc.subr

name="bluetoothmgrd"
desc="BluetoothMgr Bluetooth connection manager"
rcvar="bluetoothmgrd_enable"

command="/usr/local/sbin/${name}"

# The daemon backgrounds itself, so rc.subr supervises it by its pidfile.
procname="${command}"

required_modules="ng_btsocket"

load_rc_config $name

: ${bluetoothmgrd_enable:="NO"}
: ${bluetoothmgrd_socket:="/var/run/bluetoothmgr.sock"}
: ${bluetoothmgrd_pidfile:="/var/run/${name}.pid"}

# Passed to -p as well, or stop and status would look in the wrong place.
pidfile="${bluetoothmgrd_pidfile}"

# Moving the socket means exporting $BTMGR_SOCKET in the session too.
command_args="-s ${bluetoothmgrd_socket} -p ${bluetoothmgrd_pidfile}"

# SIGHUP makes the daemon re-read state and push it to clients. It does not
# re-exec, so reload is cheap and never drops a connection.
extra_commands="reload"

run_rc_command "$1"
