#!/bin/sh
#
# PROVIDE: bluetoothmgrd
# REQUIRE: DAEMON hcsecd
# KEYWORD: nojail shutdown suspend resume
#
# bluetoothmgrd_enable="YES"
# bluetoothmgrd_flags=""

. /etc/rc.subr

name="bluetoothmgrd"
desc="BluetoothMgr Bluetooth connection manager"
rcvar="bluetoothmgrd_enable"

command="@SBINDIR@/${name}"

# The daemon backgrounds itself, so rc.subr supervises it by its pidfile.
procname="${command}"

required_modules="ng_btsocket"

load_rc_config $name

: ${bluetoothmgrd_enable:="NO"}

# The daemon's own fixed path, so stop and status find it.
pidfile="/var/run/${name}.pid"

# SIGHUP makes the daemon re-read state and push it to clients. It does not
# re-exec, so reload is cheap and never drops a connection.
extra_commands="reload suspend resume"

# rc.suspend and rc.resume call these, so the daemon is gone across S3.
suspend_cmd="${name}_suspend"
resume_cmd="${name}_resume"

bluetoothmgrd_suspend()
{
	/usr/sbin/service ${name} stop
}

bluetoothmgrd_resume()
{
	/usr/sbin/service ${name} start
}

run_rc_command "$1"
